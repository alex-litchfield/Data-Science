          <mods:location>
            <mods:url>https://archive.ics.uci.edu/ml/datasets/iris</mods:url>
          </mods:location>
          <mods:note>HDF5 includes datasets for sepal_length, sepal_width, petal_length, petal_width, species.</mods:note>
        </mods:mods>
      </mets:xmlData>
    </mets:mdWrap>
